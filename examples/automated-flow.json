{
  "version": 1,
  "name": "Automated release validation",
  "variables": {
    "environment": "staging"
  },
  "steps": [
    {
      "id": "release",
      "component": "input",
      "save_as": "release",
      "args": {
        "value": "v2.0.0",
        "accept": true,
        "required": true
      }
    },
    {
      "id": "action",
      "component": "choose",
      "args": {
        "items": ["Deploy", "Build", "Test"],
        "filter": true,
        "query": "dpl",
        "select_1": true
      }
    },
    {
      "id": "approval",
      "component": "confirm",
      "args": {
        "message": "Deploy ${variables.release.value} to ${variables.environment}?",
        "yes": true
      }
    }
  ]
}
